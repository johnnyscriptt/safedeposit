{
  "schemaVersion": 1,
  "id": "safedeposit",
  "version": "${version}",
  "name": "Safe Deposit",
  "description": "One click deposits your inventory into a chest, except the slots you lock.",
  "authors": [
    "johnnyscriptt"
  ],
  "contact": {
    "homepage": "https://github.com/johnnyscriptt/safedeposit",
    "sources": "https://github.com/johnnyscriptt/safedeposit",
    "issues": "https://github.com/johnnyscriptt/safedeposit/issues"
  },
  "license": "MIT",
  "icon": "assets/safedeposit/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.johnnyscriptt.safedeposit.SafeDepositMod"
    ],
    "client": [
      "io.github.johnnyscriptt.safedeposit.client.SafeDepositClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "mixins": [
    {
      "config": "safedeposit.client.mixins.json",
      "environment": "client"
    }
  ],
  "suggests": {
    "chestbuttons": "*"
  }
}
